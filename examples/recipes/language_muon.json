{
  "training_provider": "dense",
  "model": {
    "architecture": "qwen3",
    "vocab_size": 259,
    "hidden_size": 32,
    "intermediate_size": 64,
    "num_hidden_layers": 2,
    "num_attention_heads": 4,
    "num_key_value_heads": 2,
    "max_position_embeddings": 64,
    "tie_word_embeddings": true
  },
  "data": "examples/data/tiny_text.jsonl",
  "training": {
    "steps": 20,
    "batch_size": 2,
    "accumulation_steps": 2,
    "max_length": 64,
    "learning_rate": 0.0003,
    "seed": 7,
    "checkpoint_every": 5,
    "optimizer": {
      "type": "muon",
      "profile": "keller",
      "matrix_learning_rate": 0.002,
      "auxiliary_modules": ["lm_head"],
      "missing_grad": "zero"
    }
  }
}
